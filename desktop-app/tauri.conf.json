{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "StackNodes",
  "version": "0.1.1+2",
  "identifier": "com.ivaan.stacknodes",
  "build": {
    "frontendDist": "../public",
    "devUrl": null,
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
   "app": {
     "windows": [
      {
        "title": "StackNodes",
        "width": 1024,
        "height": 768,
        "minWidth": 480,
        "minHeight": 320,
        "url": "/app/index.html",
        "decorations": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
